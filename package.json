{
  "name": "@aantenore/pi-otel",
  "version": "0.1.0",
  "description": "OpenTelemetry adapter for the @earendil-works/pi-telemetry contract",
  "license": "MIT",
  "author": "Antonio Antenore",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-telemetry": "^1.3.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-telemetry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-telemetry": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantenore/pi-otel.git"
  },
  "homepage": "https://github.com/aantenore/pi-otel#readme",
  "bugs": {
    "url": "https://github.com/aantenore/pi-otel/issues"
  },
  "keywords": [
    "pi",
    "pi-telemetry",
    "opentelemetry",
    "otel",
    "otlp",
    "tracing",
    "llm",
    "genai",
    "observability",
    "agents"
  ]
}
